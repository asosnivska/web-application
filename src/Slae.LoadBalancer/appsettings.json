{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000;https://localhost:5443",
  "LoadBalancer": {
    "Backends": [ "http://localhost:5001", "http://localhost:5002" ],
    "HealthCheckSeconds": 3,
    "HealthTimeoutSeconds": 2,
    "RequestTimeoutSeconds": 30
  }
}
